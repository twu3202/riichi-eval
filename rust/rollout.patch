+++ b/libriichi/src/agent/forced.rs
@@ -0,0 +1,303 @@
+//! Forced-prefix wrapper for counterfactual rollouts (riichi-eval).
+//!
+//! A rollout game starts at the beginning of a logged round (same seed, so the
+//! same wall). Until the branch point every seat replays its reaction from the
+//! reference log; at the branch point the branch actor plays a replacement
+//! event; after that every seat is driven by its inner agent.
+use super::{BatchAgent, InvisibleState};
+use crate::arena::GameResult;
+use crate::mjai::{Event, EventExt, Metadata};
+use crate::must_tile;
+use crate::state::PlayerState;
+use std::sync::Arc;
+
+use anyhow::{Result, ensure};
+
+/// A macro-action the branch actor keeps to after its replacement, for the
+/// rest of the branch kyoku, on top of its inner agent's choices.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Commit {
+    #[default]
+    None,
+    /// Betaori: whenever a genbutsu discard is legal, discard the one the
+    /// inner agent values most; never riichi, call or kan; agari is kept.
+    Fold,
+    /// Never declare riichi.
+    Dama,
+}
+
+/// Shared by the four seats of one rollout game.
+pub struct RolloutScript {
+    /// Events of the start round as logged, beginning with `start_kyoku`.
+    pub reference: Vec<Event>,
+    /// Live log length at which the branch decision is taken.
+    pub branch_pos: usize,
+    pub branch_actor: u8,
+    /// `None` means the branch actor plays freely from the branch point on
+    /// (used for the replay-fidelity control).
+    pub replacement: Option<Event>,
+    pub commit: Commit,
+}
+
+const fn actor_of(ev: &Event) -> Option<u8> {
+    match *ev {
+        Event::Dahai { actor, .. }
+        | Event::Chi { actor, .. }
+        | Event::Pon { actor, .. }
+        | Event::Daiminkan { actor, .. }
+        | Event::Kakan { actor, .. }
+        | Event::Ankan { actor, .. }
+        | Event::Reach { actor }
+        | Event::Hora { actor, .. } => Some(actor),
+        _ => None,
+    }
+}
+
+/// The reaction `actor` took at live log position `pos` in the reference.
+/// Board-generated `reach_accepted` / `dora` may precede the event that
+/// resolves the decision, and simultaneous rons are logged back to back, so
+/// those are skipped; anything else that follows means the actor passed.
+fn reference_reaction(reference: &[Event], pos: usize, actor: u8, state: &PlayerState) -> Event {
+    for ev in reference.iter().skip(pos) {
+        match *ev {
+            Event::Hora {
+                actor: a, target, ..
+            } if a == actor => {
+                return Event::Hora {
+                    actor,
+                    target,
+                    deltas: None,
+                    ura_markers: None,
+                };
+            }
+            Event::Hora { .. } | Event::ReachAccepted { .. } | Event::Dora { .. } => continue,
+            Event::Ryukyoku { .. } => {
+                // Kyuushu kyuuhai is declared by the player on turn; the log
+                // event carries no actor.
+                return if state.last_cans().can_ryukyoku {
+                    Event::Ryukyoku { deltas: None }
+                } else {
+                    Event::None
+                };
+            }
+            _ => {
+                return if actor_of(ev) == Some(actor) {
+                    ev.clone()
+                } else {
+                    Event::None
+                };
+            }
+        }
+    }
+    Event::None
+}
+
+/// Genbutsu kinds for `me` against every opponent whose riichi is accepted
+/// (their own discards plus tiles passed after their riichi), intersected;
+/// `None` if no opponent is in riichi. Mirrors `riichi_eval.replay`.
+fn genbutsu(log: &[EventExt], me: u8) -> Option<[bool; 34]> {
+    let mut riichi = [false; 4];
+    let mut safe = [[false; 34]; 4];
+    for ev in log {
+        match ev.event {
+            Event::Dahai { actor, pai, .. } => {
+                let k = pai.deaka().as_usize();
+                safe[actor as usize][k] = true;
+                for o in 0..4 {
+                    if riichi[o] && o != actor as usize {
+                        safe[o][k] = true;
+                    }
+                }
+            }
+            Event::ReachAccepted { actor } => riichi[actor as usize] = true,
+            _ => (),
+        }
+    }
+    let mut out = [true; 34];
+    let mut any = false;
+    for o in (0..4).filter(|&o| o != me as usize && riichi[o]) {
+        any = true;
+        for (x, &y) in out.iter_mut().zip(&safe[o]) {
+            *x &= y;
+        }
+    }
+    any.then_some(out)
+}
+
+/// The legal action with the highest Q among those `allow` admits, from the
+/// inner agent's metadata (compact Q values over the set mask bits).
+fn best_of(meta: &Metadata, allow: impl Fn(usize) -> bool) -> Option<usize> {
+    let (q, bits) = (meta.q_values.as_ref()?, meta.mask_bits?);
+    let mut best: Option<(usize, f32)> = None;
+    for (a, &v) in (0..64).filter(|a| bits >> a & 1 == 1).zip(q) {
+        if allow(a) && best.is_none_or(|(_, b)| v > b) {
+            best = Some((a, v));
+        }
+    }
+    best.map(|(a, _)| a)
+}
+
+fn apply_commit(
+    commit: Commit,
+    actor: u8,
+    log: &[EventExt],
+    state: &PlayerState,
+    ext: EventExt,
+) -> EventExt {
+    let Some(meta) = ext.meta.as_ref() else {
+        // quick-eval reaction: the only legal discard, nothing to choose
+        return ext;
+    };
+    let discard = |a: usize| {
+        let pai = must_tile!(a);
+        let tsumogiri = state.last_self_tsumo().is_some_and(|t| t == pai);
+        Event::Dahai {
+            actor,
+            pai,
+            tsumogiri,
+        }
+    };
+    let replace = match (commit, &ext.event) {
+        (Commit::None, _) | (_, Event::Hora { .. }) => None,
+        (Commit::Dama, Event::Reach { .. }) => best_of(meta, |a| a <= 36).map(discard),
+        (Commit::Dama, _) => None,
+        (Commit::Fold, ev) if state.last_cans().can_discard => {
+            let safe = genbutsu(log, actor);
+            let is_safe = |a: usize| a <= 36 && safe.is_some_and(|s| s[must_tile!(a).deaka().as_usize()]);
+            match ev {
+                Event::Dahai { pai, .. } if safe.is_some_and(|s| s[pai.deaka().as_usize()]) => None,
+                // a non-genbutsu discard: swap for the best genbutsu if any is legal
+                Event::Dahai { .. } => best_of(meta, is_safe).map(discard),
+                // riichi / kan: best genbutsu, else the best plain discard
+                _ => best_of(meta, is_safe)
+                    .or_else(|| best_of(meta, |a| a <= 36))
+                    .map(discard),
+            }
+        }
+        (Commit::Fold, Event::None) => None,
+        // a call offered on someone else's discard: decline
+        (Commit::Fold, _) => Some(Event::None),
+    };
+    match replace {
+        Some(event) => EventExt {
+            event,
+            meta: ext.meta,
+        },
+        None => ext,
+    }
+}
+
+pub struct ForcedPrefixAgent {
+    inner: Box<dyn BatchAgent>,
+    player_ids: Vec<u8>,
+    scripts: Vec<Arc<RolloutScript>>,
+    in_first_kyoku: Vec<bool>,
+    pending: Vec<Option<Event>>,
+}
+
+impl ForcedPrefixAgent {
+    pub fn new(
+        inner: Box<dyn BatchAgent>,
+        player_ids: Vec<u8>,
+        scripts: Vec<Arc<RolloutScript>>,
+    ) -> Result<Self> {
+        ensure!(player_ids.len() == scripts.len());
+        let n = player_ids.len();
+        Ok(Self {
+            inner,
+            player_ids,
+            scripts,
+            in_first_kyoku: vec![false; n],
+            pending: vec![None; n],
+        })
+    }
+}
+
+impl BatchAgent for ForcedPrefixAgent {
+    fn name(&self) -> String {
+        self.inner.name()
+    }
+
+    fn oracle_obs_version(&self) -> Option<u32> {
+        self.inner.oracle_obs_version()
+    }
+
+    fn set_scene(
+        &mut self,
+        index: usize,
+        log: &[EventExt],
+        state: &PlayerState,
+        invisible_state: Option<InvisibleState>,
+    ) -> Result<()> {
+        self.pending[index] = None;
+        if self.in_first_kyoku[index] {
+            let script = &self.scripts[index];
+            let pos = log.len();
+            let actor = self.player_ids[index];
+            let is_branch = pos == script.branch_pos && actor == script.branch_actor;
+            let forced = pos < script.branch_pos || pos == script.branch_pos && !is_branch;
+            if forced || is_branch && script.replacement.is_some() {
+                ensure!(
+                    pos >= 1 && pos <= script.reference.len(),
+                    "rollout: live log length {pos} outside reference (len {})",
+                    script.reference.len(),
+                );
+                ensure!(
+                    log[0].event == script.reference[0],
+                    "rollout: start_kyoku differs from reference (wall/seed mismatch)",
+                );
+                ensure!(
+                    log[pos - 1].event == script.reference[pos - 1],
+                    "rollout: diverged from reference before the branch at log position {pos}: live {:?} vs reference {:?}",
+                    log[pos - 1].event,
+                    script.reference[pos - 1],
+                );
+                let ev = if forced {
+                    reference_reaction(&script.reference, pos, actor, state)
+                } else {
+                    script.replacement.clone().unwrap_or_default()
+                };
+                self.pending[index] = Some(ev);
+                return Ok(());
+            }
+        }
+        self.inner.set_scene(index, log, state, invisible_state)
+    }
+
+    fn get_reaction(
+        &mut self,
+        index: usize,
+        log: &[EventExt],
+        state: &PlayerState,
+        invisible_state: Option<InvisibleState>,
+    ) -> Result<EventExt> {
+        if let Some(ev) = self.pending[index].take() {
+            return Ok(EventExt::no_meta(ev));
+        }
+        let ext = self.inner.get_reaction(index, log, state, invisible_state)?;
+        let script = &self.scripts[index];
+        let actor = self.player_ids[index];
+        if self.in_first_kyoku[index]
+            && script.commit != Commit::None
+            && actor == script.branch_actor
+            && log.len() > script.branch_pos
+        {
+            return Ok(apply_commit(script.commit, actor, log, state, ext));
+        }
+        Ok(ext)
+    }
+
+    fn start_game(&mut self, index: usize) -> Result<()> {
+        self.in_first_kyoku[index] = true;
+        self.inner.start_game(index)
+    }
+
+    fn end_kyoku(&mut self, index: usize) -> Result<()> {
+        self.in_first_kyoku[index] = false;
+        self.inner.end_kyoku(index)
+    }
+
+    fn end_game(&mut self, index: usize, game_result: &GameResult) -> Result<()> {
+        self.inner.end_game(index, game_result)
+    }
+}
