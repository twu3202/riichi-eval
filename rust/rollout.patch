diff --git a/libriichi/src/arena/rollout.rs b/libriichi/src/arena/rollout.rs
new file mode 100644
index 0000000..6237ad6
--- /dev/null
+++ b/libriichi/src/arena/rollout.rs
@@ -0,0 +1,178 @@
+//! Counterfactual rollouts for riichi-eval.
+//!
+//! Each spec restarts a logged game at the beginning of one kyoku (same seed,
+//! hence the same wall), replays the logged reactions up to a branch point,
+//! lets the branch actor play a replacement event, and continues with the
+//! given engines until the end of that kyoku or of the game.
+use super::game::{BatchGame, GameInit, Index};
+use crate::agent::{BatchAgent, Commit, ForcedPrefixAgent, RolloutScript, new_py_agent};
+use crate::mjai::{Event, EventExt};
+use std::sync::Arc;
+
+use anyhow::{Context, Result, bail, ensure};
+use pyo3::prelude::*;
+use serde_json as json;
+
+#[derive(FromPyObject)]
+#[pyo3(from_item_all)]
+pub struct RolloutSpec {
+    /// (nonce, key) from the logged `start_game`.
+    seed: (u64, u64),
+    /// 0-based kyoku index of the whole game (E1 = 0, S1 = 4, W1 = 8).
+    kyoku: u8,
+    honba: u8,
+    kyotaku: u8,
+    scores: [i32; 4],
+    in_renchan: bool,
+    /// Index into `engines` for each seat.
+    seat_engines: [usize; 4],
+    /// Logged events of that kyoku as JSON lines, from `start_kyoku` on.
+    reference: Vec<String>,
+    branch_pos: usize,
+    branch_actor: u8,
+    /// Replacement reaction as mjai JSON; `None` = play freely from the branch.
+    replacement: Option<String>,
+    /// "kyoku" or "game".
+    horizon: String,
+    /// "" (none), "fold" or "dama": a macro-action the branch actor keeps to
+    /// for the rest of the branch kyoku (see `Commit`).
+    commit: String,
+}
+
+#[pyclass]
+#[derive(Clone, Default)]
+pub struct Rollout {
+    pub disable_progress_bar: bool,
+}
+
+fn parse_event(line: &str) -> Result<Event> {
+    let ext: EventExt = json::from_str(line).with_context(|| format!("bad mjai json: {line}"))?;
+    Ok(ext.event)
+}
+
+#[pymethods]
+impl Rollout {
+    /// Lets Python refuse a `commit` spec on a build that would ignore it.
+    #[classattr]
+    const SUPPORTS_COMMIT: bool = true;
+
+    #[new]
+    #[pyo3(signature = (*, disable_progress_bar=true))]
+    const fn new(disable_progress_bar: bool) -> Self {
+        Self {
+            disable_progress_bar,
+        }
+    }
+
+    /// Returns, per spec: (json log, final scores, scores after the first
+    /// kyoku, kyotaku left after it, (kyoku, honba) of the next kyoku or
+    /// `None` if the game ended there).
+    #[allow(clippy::type_complexity)]
+    pub fn run(
+        &self,
+        engines: Vec<PyObject>,
+        specs: Vec<RolloutSpec>,
+        py: Python<'_>,
+    ) -> Result<Vec<(String, [i32; 4], [i32; 4], u8, Option<(u8, u8)>)>> {
+        ensure!(!engines.is_empty(), "no engines");
+        ensure!(!specs.is_empty(), "no specs");
+
+        let n_engines = engines.len();
+        let mut player_ids: Vec<Vec<u8>> = vec![vec![]; n_engines];
+        let mut scripts: Vec<Vec<Arc<RolloutScript>>> = vec![vec![]; n_engines];
+        let mut indexes = Vec::with_capacity(specs.len());
+        let mut seeds = Vec::with_capacity(specs.len());
+        let mut inits = Vec::with_capacity(specs.len());
+
+        for (i, spec) in specs.iter().enumerate() {
+            let reference = spec
+                .reference
+                .iter()
+                .map(|l| parse_event(l))
+                .collect::<Result<Vec<_>>>()
+                .with_context(|| format!("spec #{i}"))?;
+            ensure!(
+                matches!(reference.first(), Some(Event::StartKyoku { .. })),
+                "spec #{i}: reference must start with start_kyoku",
+            );
+            let replacement = spec
+                .replacement
+                .as_deref()
+                .map(parse_event)
+                .transpose()
+                .with_context(|| format!("spec #{i}"))?;
+            let stop_after_first_kyoku = match spec.horizon.as_str() {
+                "kyoku" => true,
+                "game" => false,
+                h => bail!("spec #{i}: unknown horizon {h}"),
+            };
+            let commit = match spec.commit.as_str() {
+                "" | "none" => Commit::None,
+                "fold" => Commit::Fold,
+                "dama" => Commit::Dama,
+                c => bail!("spec #{i}: unknown commit {c}"),
+            };
+            let script = Arc::new(RolloutScript {
+                reference,
+                branch_pos: spec.branch_pos,
+                branch_actor: spec.branch_actor,
+                replacement,
+                commit,
+            });
+
+            let mut idxs = [Index::default(); 4];
+            for (seat, &e) in spec.seat_engines.iter().enumerate() {
+                ensure!(e < n_engines, "spec #{i}: engine index {e} out of range");
+                idxs[seat] = Index {
+                    agent_idx: e,
+                    player_id_idx: player_ids[e].len(),
+                };
+                player_ids[e].push(seat as u8);
+                scripts[e].push(Arc::clone(&script));
+            }
+            indexes.push(idxs);
+            seeds.push(spec.seed);
+            inits.push(GameInit {
+                kyoku: spec.kyoku,
+                honba: spec.honba,
+                kyotaku: spec.kyotaku,
+                scores: spec.scores,
+                in_renchan: spec.in_renchan,
+                stop_after_first_kyoku,
+            });
+        }
+
+        let batch_game = BatchGame {
+            length: 8,
+            init_scores: [25000; 4],
+            disable_progress_bar: self.disable_progress_bar,
+        };
+
+        py.allow_threads(move || {
+            let mut agents = engines
+                .into_iter()
+                .zip(player_ids)
+                .zip(scripts)
+                .map(|((engine, ids), scr)| {
+                    let inner = new_py_agent(engine, &ids)?;
+                    Ok(Box::new(ForcedPrefixAgent::new(inner, ids, scr)?) as Box<dyn BatchAgent>)
+                })
+                .collect::<Result<Vec<_>>>()?;
+
+            let results = batch_game.run_with_init(&mut agents, &indexes, &seeds, Some(&inits))?;
+            results
+                .into_iter()
+                .map(|(r, first)| {
+                    let first = first.context("rollout game ended before its first kyoku")?;
+                    Ok((
+                        r.dump_json_log()?,
+                        r.scores,
+                        first.scores,
+                        first.kyotaku,
+                        first.next,
+                    ))
+                })
+                .collect()
+        })
+    }
+}
